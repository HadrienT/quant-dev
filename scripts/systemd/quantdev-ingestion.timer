[Unit]
Description=Run the quant-dev ingestion after the US market close

[Timer]
# 22:00 Europe/Paris on weekdays, matching the Cloud Scheduler job it replaces
# ("0 22 * * 1-5"). The US session closes at 16:00 New York, which is 22:00 or
# 23:00 in Paris depending on how the two DST calendars line up, so the run can
# land before the close for a couple of weeks a year; the upsert is idempotent
# and the next day's run corrects it.
OnCalendar=Mon..Fri 22:00
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
