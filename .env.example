# Copy to .env and fill in. .env is git-ignored.
#
# These must match the data-ingest stack, which owns the database. PGHOST and
# PGPORT are the service name and port inside data-ingest's compose network.
PGHOST=postgres
PGPORT=5432
PGDATABASE=dataingest
PGUSER=dataingest
PGPASSWORD=change-me

FRED_API_KEY=
